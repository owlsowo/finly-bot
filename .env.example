# Finly is hard-locked to Alpaca paper trading. The application refuses any other host.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Official Alpaca MCP v2 variable names. Keep these values only in the local MCP
# client configuration or process environment; never commit them.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data,news,corporate-actions
FINLY_COMPETITION_ACCOUNT_ID=

# Local-only Llama-compatible endpoint. Ollama exposes this path by default.
FINLY_LLAMA_BASE_URL=http://127.0.0.1:11434/v1
FINLY_LLAMA_MODEL=llama3.2:1b

# Keep false for judged runs. When true, the local gateway can use the deterministic
# replay planner if no local model is running.
FINLY_ALLOW_DETERMINISTIC_FALLBACK=false

# Read/decide autonomous paper loop. A zero interval runs exactly once. News
# evidence is omitted unless the loopback-only local Llama extractor is opted in.
FINLY_AGENT_INTERVAL_SECONDS=0
FINLY_HORIZON_SESSIONS=3
FINLY_USE_LOCAL_LLAMA_EVENTS=false
FINLY_DECISION_LOG=outputs/autonomous_decisions.jsonl
FINLY_AGENT_LOCK_PATH=data/private/autonomous-paper-agent.lock
FINLY_PAPER_SIGNING_SECRET=
FINLY_PERMIT_LEDGER_PATH=data/ledger
FINLY_LIFECYCLE_CHECKPOINT_PATH=data/private/paper-lifecycle
FINLY_PAPER_SESSION_PATH=data/private/paper-sessions

# MCP is the required write transport for the judged demonstration. Enabling
# mutation additionally requires the exact paper-only acknowledgement documented
# in docs/MCP_SETUP.md. Keep both fields disabled until the controlled checklist
# is complete.
FINLY_EXECUTION_TRANSPORT=mcp
FINLY_EXECUTION_ENABLED=false
FINLY_PAPER_MUTATION_ACK=

# Optional absolute local paths. Defaults target the ignored pinned virtualenv.
FINLY_MCP_PYTHON=
FINLY_MCP_SERVER_COMMAND=
