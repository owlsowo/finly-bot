{
  "name": "finly-bot",
  "version": "0.4.3",
  "private": true,
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/run_replay.mjs",
    "check": "node scripts/check_receipt.mjs",
    "mcp:verify": "node scripts/verify_mcp_config.mjs",
    "mcp:runtime": ".venv-alpaca-mcp/bin/python scripts/introspect_alpaca_mcp.py",
    "paper:health": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/paper_healthcheck.mjs",
    "paper:agent": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/autonomous_paper_agent.mjs",
    "llama:api": "node scripts/local_llama_api.mjs",
    "llama:decision-trace": "node scripts/run_llama_decision_trace.mjs",
    "llama:decision-replay": "node scripts/replay_recorded_llama_trace.mjs",
    "llama:decision-check": "node scripts/check_llama_decision_trace.mjs",
    "backtest": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run_historical_backtest.mjs",
    "research:economic": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run_economic_research.mjs",
    "research:economic-check": "node scripts/check_economic_research.mjs",
    "research:quant-extension": "node --env-file-if-exists=.env --env-file-if-exists=.env.local research/run_quant_candidate_extension.mjs",
    "research:quant-extension-check": "node research/check_quant_candidate_extension.mjs",
    "research:g4-window-explorer": "node research/build_g4_window_explorer.mjs",
    "research:dca": "node research/run_recurring_contribution_analysis.mjs",
    "research:forward-trial": "node research/run_forward_trial1.mjs --verify-existing",
    "research:forward-trial-live": "node --env-file-if-exists=.env.local research/run_forward_trial_live.mjs --verify-existing",
    "research:forward-trial-live:activate": "node --env-file-if-exists=.env.local research/run_forward_trial_live.mjs --activate",
    "research:forward-trial-live:append": "node --env-file-if-exists=.env.local research/run_forward_trial_live.mjs --append-signal-commitment",
    "research:forward-trial-live:verify-github": "node scripts/verify_forward_live_github_publication.mjs",
    "economic:decision": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run_current_economic_decision.mjs",
    "economic:decision-check": "node scripts/check_current_economic_decision.mjs",
    "economic:options-replay": "node scripts/run_economic_options_replay.mjs",
    "economic:options-replay-check": "node scripts/check_economic_options_replay.mjs",
    "video:build": "python3 scripts/build_demo_video.py",
    "submission:check": "node scripts/check_submission_artifacts.mjs",
    "verify": "npm run lint && npm test && npm run demo && npm run check && npm run llama:decision-check && npm run research:economic-check && npm run economic:decision-check && npm run economic:options-replay-check && npm run research:forward-trial && npm run research:forward-trial-live && npm run mcp:verify && npm run submission:check && npm run build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  },
  "type": "module"
}
